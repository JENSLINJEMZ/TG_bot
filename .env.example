TELEGRAM_BOT_TOKEN=123456789:replace-with-botfather-token

# comma-separated telegram user ids allowed to use the bot; empty = everyone
ALLOWED_USERS=
# one telegram id allowed to run the hidden admin commands (/stats, /last).
# They never appear in the chat input menu; empty = disabled for everyone.
OWNER_USER_ID=
# minimum seconds between heavy requests (diffusion, chat) per user; 0 disables
COOLDOWN_SECONDS=30
# background color when the message has no caption: hex like #ffffff
DEFAULT_BACKGROUND=#ffffff
# largest edge length for inference (photos are downscaled first)
MAX_IMAGE_DIM=1600
# reject photos larger than this before decoding them (bytes)
MAX_PHOTO_BYTES=15728640
# how many photos may be processed at once (1 = serialize, kind to the CPU)
MAX_CONCURRENT=1
# pin model weights to an immutable revision; empty = track the main branch
#DIFFUSE_REVISION=cad0bd7495fa6c4bcca01b19a723dc91627fe84f
#CHAT_REVISION=12fd25f77366fa6b3b4b768ec3050bf629380bac

# Processed media and chat turns are stored in a local SQLite database.
OFFLINE_STORE_ENABLED=1
# relative paths are resolved against the project folder
OFFLINE_STORE_PATH=data/offline.db

# GPU outfit editor: Qwen-Image-Edit-2509 (4-bit Nunchaku SVDQuant).
# Requires CUDA torch + the nunchaku wheel; falls back to diffuse/tint if missing.
EDIT_ENABLED=1
# base pipeline components (text encoder, VAE, tokenizer, scheduler) + quant repo
EDIT_BASE=Qwen/Qwen-Image-Edit-2509
EDIT_REPO=nunchaku-tech/nunchaku-qwen-image-edit-2509
# Lightning checkpoint: 4 or 8 steps; rank 32 (smaller) or 128 (higher quality)
EDIT_STEPS=4
EDIT_RANK=32
# guidance for the Lightning checkpoint (1.0); use 4.0 for the non-Lightning model
EDIT_CFG=1.0
# transformer blocks kept resident on the GPU (raise with more VRAM)
EDIT_GPU_BLOCKS=1
# working resolution for the editor (its native res is too big for an 8 GB card)
EDIT_MAX_DIM=768
# how a short caption (e.g. "bikini") is turned into an edit instruction
EDIT_PROMPT_TEMPLATE=Replace the person's existing clothing with {prompt}, worn naturally on their body.
# appended so faces/pose stay stable; set empty to disable
EDIT_IDENTITY_CLAUSE=Keep the person's face, pose and background unchanged.
# prompt wrapper for the multi-image "combine two photos" mode ({prompt} = user text)
EDIT_COMBINE_TEMPLATE=Using the two reference photos, create one natural photo: {prompt}. Keep both people's faces and identities exactly the same.

# image-to-video animation via diffusers on CUDA.
VIDEO_ENABLED=1
# which backend the "animate" flow uses:
#   wan    -> Wan 2.2 TI2V-5B Turbo (4-step, uncensored) [fast, in-process]
#   wan14b -> Wan 2.2 I2V-A14B (14B) via a local ComfyUI server [best quality]
#   ltx    -> LTX-Video 2B
VIDEO_ENGINE=wan

# --- settings shared by every engine ---
# video frame rate of the result file
VIDEO_FPS=24
# total generated frames; 121 @ 24 fps = 5.04 s; raise for longer clips
VIDEO_FRAMES=121
# clip lengths (seconds) offered as buttons in the video flow
VIDEO_DURATIONS=5,10,15
# longest input edge fed to the model (rounded to a multiple of 32)
VIDEO_MAX_DIM=704
VIDEO_NEGATIVE=worst quality, inconsistent motion, blurry, jittery, distorted
# default motion prompt when an empty prompt is sent (face/identity locked)
VIDEO_DEFAULT_PROMPT=The subject moves gently with subtle natural motion while the camera stays stable. Keep the subject's face, identity and overall appearance exactly the same as in the input photo.

# --- Wan 2.2 TI2V-5B Turbo (uncensored, 4-step, CFG-free) ---
# local copy at models/wan-ti2v-5b is used when present; else downloaded
WAN_MODEL=yetter-ai/Wan2.2-TI2V-5B-Turbo-Diffusers
WAN_STEPS=4
WAN_CFG=1.0
WAN_FLOW_SHIFT=5.0

# --- LTX-Video 2B (alternative backend) ---
VIDEO_MODEL=Lightricks/LTX-Video
VIDEO_STEPS=40
VIDEO_CFG=3.0

# --- Wan 2.2 I2V-A14B (14B) via ComfyUI (VIDEO_ENGINE=wan14b) ---
# The 14B two-expert model runs in a separate ComfyUI server (GGUF Q3 +
# LightX2V 4-step LoRAs) because that is the reliable way to fit it on an 8 GB
# card. The bot only talks to it over HTTP. Model files live under
# COMFY_DIR\models (see D:\JEMZ\ComfyUI\dl_models.py / dl_post.py).
COMFY_URL=http://127.0.0.1:8188
COMFY_DIR=D:\JEMZ\ComfyUI
# start ComfyUI automatically if it is not already running
COMFY_AUTOSTART=1
# per-clip timeout in seconds (14B on 8 GB can take several minutes)
COMFY_TIMEOUT=3600
# model file names (resolved inside COMFY_DIR\models)
WAN14B_HIGH=wan2.2_i2v_high_noise_14B_Q3_K_M.gguf
WAN14B_LOW=wan2.2_i2v_low_noise_14B_Q3_K_M.gguf
WAN14B_LORA_HIGH=wan2.2_i2v_lightx2v_4steps_lora_v1_high_noise.safetensors
WAN14B_LORA_LOW=wan2.2_i2v_lightx2v_4steps_lora_v1_low_noise.safetensors
WAN14B_CLIP=umt5-xxl-encoder-Q5_K_M.gguf
WAN14B_VAE=wan_2.1_vae.safetensors
# sampling (LightX2V 4-step: cfg 1.0, shift 5.0)
WAN14B_STEPS=4
WAN14B_CFG=1.0
WAN14B_SHIFT=5.0
# native Wan frame rate; RIFE interpolation (WAN14B_INTERP) multiplies the
# delivered fps, so 12 x 2 = 24 fps
WAN14B_FPS=12
# longest edge fed to the model (result is then upscaled by the post pass)
WAN14B_BASE_DIM=832
# clips >= this many seconds fall back to a smaller base resolution so the 14B
# model + the larger activations still fit on an 8 GB card (the upscale post
# pass is usually skipped for long clips anyway). 0 or a dim >= BASE_DIM
# disables the fallback.
WAN14B_LONG_SECONDS=8
WAN14B_LONG_BASE_DIM=512
# long clips also ease the native frame rate down (fewer frames = less sampling,
# interpolation and encoding). Applied as min(WAN14B_FPS, WAN14B_LONG_FPS);
# 0 keeps the full WAN14B_FPS for long clips.
WAN14B_LONG_FPS=12
# post passes: swap the generated face back to the source photo, restore it,
# smooth the motion and upscale -- this removes the "choppy old AI" look
WAN14B_FACE_SWAP=1
WAN14B_FACE_RESTORE=1
WAN14B_UPSCALE=1
WAN14B_UPSCALE_MODEL=RealESRGAN_x2.pth
# skip the 2x upscale once the interpolated clip exceeds this many frames
# (keeps long clips from running out of RAM); 0 = never skip
WAN14B_UPSCALE_MAX_FRAMES=200
WAN14B_INTERP=2
# ReActor model names (must exist under COMFY_DIR\models)
WAN14B_SWAP_MODEL=inswapper_128.onnx
WAN14B_RESTORE_MODEL=GFPGANv1.4.pth
WAN14B_FACE_DETECT=retinaface_resnet50
WAN14B_RIFE_MODEL=rife49.pth
# 0 = pick a fresh random seed per job
WAN14B_SEED=0
